# TradeIT configuration template.
#
#   cp .env.example .env    # then edit the values below
#
# Keep the plain KEY=value form with no spaces or quotes. The services read this file
# through godotenv, and Docker Compose reads the same file for variable substitution, and
# only this form is parsed reliably by both.

# --- Postgres (source of truth) ---
db_host=localhost
db_port=5432
db_user=postgres
db_passwd=change-me
db_name=tradeit

# --- Redis (order-status cache) ---
redis_addr=localhost:6379
redis_password=

# --- JWT signing key (required) ---
# The user-order service refuses to start with an empty key.
jwtkey=change-me-to-a-long-random-string

# --- Shared ingest configuration (symbol table + ring/WAL knobs) ---
TRADEIT_CONFIG=config/tradeit.toml

# --- Host port overrides (optional; used by docker compose only) ---
# Change these if the defaults are already taken on your machine.
TRADEIT_DB_PORT=5432
TRADEIT_REDIS_PORT=6379
TRADEIT_USER_ORDER_PORT=8000
TRADEIT_ENGINE_PORT=8001
TRADEIT_PROJECTION_PORT=8002
TRADEIT_PROMETHEUS_PORT=9090
TRADEIT_GRAFANA_PORT=3000

# --- Grafana admin password (observability profile) ---
grafana_admin_password=admin
