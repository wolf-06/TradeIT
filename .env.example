# Copy to .env for local (non-Docker) runs:  cp .env.example .env
# In Docker these values are provided by docker-compose.yml instead.

# JWT signing key. The user-order service refuses to start with an empty key.
jwtkey=dev-secret-change-me

# Redis (order-status cache + legacy queue path)
redis_addr=localhost:6379
redis_password=

# Postgres (source of truth)
db_host=localhost
db_port=5432
db_user=postgres
db_passwd=dev123
db_name=tradeit

# Shared ingest configuration (symbol table + ring/WAL knobs)
TRADEIT_CONFIG=config/tradeit.toml
